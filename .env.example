# MongoDB Connection
DATABASE_URL=mongodb://127.0.0.1/menfesawi

# Payload CMS Configuration
PAYLOAD_SECRET=your-payload-secret-at-least-32-chars-long
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email Configuration
MAIL_FROM=noreply@menfesawi.org
MAIL_PASS=your-mail-password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=menfesawi

# Social Announcement Publishing
SOCIAL_AUTO_PUBLISH=false
SOCIAL_PUBLISH_LANGUAGE=am
SOCIAL_PUBLISH_DESTINATIONS=telegram-channel,telegram-group

# Public Telegram Announcement Destinations
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_PUBLIC_CHANNEL_ID=@your_public_channel_username_or_id
TELEGRAM_PUBLIC_GROUP_ID=@your_public_group_username_or_id

# Private Book/File Storage (Not for announcements)
# TELEGRAM_STORAGE_CHAT_ID=-1001234567890
